{
  "name": "veilora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "cd backend && bun test --timeout 30000",
    "backend:dev": "cd backend && bun run dev",
    "compile:contracts": "bunx solc --bin --abi contracts/src/VeiloraAccount.sol contracts/src/VeiloraFactory.sol contracts/src/VeiloraShieldedPool.sol -o contracts/out",
    "deploy:contracts": "bun run contracts/script/deploy.ts",
    "push:origin": "git push origin main",
    "push:public": "python3 scripts/sync-public.py",
    "push:all": "bun run push:origin && bun run push:public"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.112.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.6",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "three": "0.169.0",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/router-plugin": "^1.112.0",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
