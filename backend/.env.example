NODE_ENV=production
PORT=3001
DATABASE_URL=
FRONTEND_URL=https://veilorarh.com
ROBINHOOD_CHAIN_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
SHARD_B_ENCRYPTION_KEY=
CO_SIGNER_SHARD_B_SECRET=
RELAYER_PRIVATE_KEY=
RELAYER_DAILY_DEPLOYMENT_LIMIT=10
VEILORA_FACTORY_ADDRESS=0xf86bea538ea756048f8df9be4bcd88aeb4d65376
VEILORA_ESCROW_FACTORY_ADDRESS=
# Explicitly approved escrow contract addresses whose outcome calls Shard B may co-sign.
VEILORA_TRUSTED_ESCROW_ADDRESSES=
USDG_TOKEN_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
VEILY_DAILY_REQUEST_LIMIT=50
BLOCKSCOUT_API_KEY=

# Evaluator performance: share DEX quotes briefly and cap concurrent Wallet Rules work.
QUOTE_PRICE_CACHE_MS=10000
RULES_EVALUATOR_CONCURRENCY=8

# Add funds (MoonPay). Leave unset to hide Add funds in the app.
MOONPAY_ENV=sandbox
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
# Direct delivery on Robinhood Chain, once MoonPay confirms support, e.g. USDG=usdg_robinhood,ETH=eth_robinhood
ONRAMP_DIRECT_CURRENCIES=
# Fallback: buy on Base, bridge with Relay (needs RELAY_LINK_API_KEY). Refunds go here, so use an address Veilora controls on Base.
ONRAMP_REFUND_ADDRESS=
ONRAMP_RELAY_FALLBACK=on
